{
    "name": "WiFi Deauth Defender",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "wifi-alert",
                "responseMode": "onReceived",
                "options": {}
            },
            "id": "webhook-node",
            "name": "WiFi Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                250,
                300
            ],
            "webhookId": "wifi-alert"
        },
        {
            "parameters": {
                "keepOnlySet": true,
                "values": {
                    "string": [
                        {
                            "name": "severity",
                            "value": "={{ $json.body.severity }}"
                        },
                        {
                            "name": "attack",
                            "value": "={{ $json.body.attack }}"
                        },
                        {
                            "name": "source",
                            "value": "={{ $json.body.source }}"
                        },
                        {
                            "name": "timestamp",
                            "value": "={{ $json.body.timestamp }}"
                        },
                        {
                            "name": "message",
                            "value": "={{ $json.body.details.message || JSON.stringify($json.body.details) }}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "extract-data",
            "name": "Extract Fields",
            "type": "n8n-nodes-base.set",
            "typeVersion": 1,
            "position": [
                450,
                300
            ]
        },
        {
            "parameters": {
                "rules": {
                    "values": [
                        {
                            "conditions": {
                                "options": {
                                    "caseSensitive": true,
                                    "leftValue": "",
                                    "typeValidation": "strict"
                                },
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.severity }}",
                                        "rightValue": "HIGH",
                                        "operator": {
                                            "type": "string",
                                            "operation": "equals"
                                        }
                                    },
                                    {
                                        "leftValue": "={{ $json.severity }}",
                                        "rightValue": "CRITICAL",
                                        "operator": {
                                            "type": "string",
                                            "operation": "equals"
                                        }
                                    }
                                ],
                                "combinator": "or"
                            },
                            "renameOutput": true,
                            "outputKey": "High Severity"
                        }
                    ]
                },
                "fallbackOutput": 1
            },
            "id": "severity-switch",
            "name": "Filter by Severity",
            "type": "n8n-nodes-base.switch",
            "typeVersion": 3,
            "position": [
                650,
                300
            ]
        },
        {
            "parameters": {
                "content": "🚨 HIGH ALERT RECEIVED!",
                "height": 265,
                "width": 328
            },
            "id": "sticky-note",
            "name": "High Alert Note",
            "type": "n8n-nodes-base.stickyNote",
            "typeVersion": 1,
            "position": [
                850,
                180
            ]
        },
        {
            "parameters": {
                "operation": "append",
                "fileName": "/home/node/.n8n/high_alerts.log",
                "content": "={{ $json.timestamp }} - {{ $json.severity }} - {{ $json.attack }} - {{ $json.source }}\n",
                "options": {}
            },
            "id": "file-log",
            "name": "Write to High Alerts Log",
            "type": "n8n-nodes-base.writeBinaryFile",
            "typeVersion": 1,
            "position": [
                1100,
                300
            ]
        },
        {
            "parameters": {
                "filePath": "/home/node/.n8n/high_alerts.log",
                "options": {}
            },
            "id": "read-file",
            "name": "Read High Alerts Log",
            "type": "n8n-nodes-base.readBinaryFile",
            "typeVersion": 1,
            "position": [
                1350,
                300
            ]
        }
    ],
    "pinData": {},
    "connections": {
        "WiFi Webhook": {
            "main": [
                [
                    {
                        "node": "Extract Fields",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Extract Fields": {
            "main": [
                [
                    {
                        "node": "Filter by Severity",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Filter by Severity": {
            "main": [
                [
                    {
                        "node": "High Alert Note",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Write to High Alerts Log",
                        "type": "main",
                        "index": 0
                    }
                ],
                []
            ]
        },
        "Write to High Alerts Log": {
            "main": [
                [
                    {
                        "node": "Read High Alerts Log",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}